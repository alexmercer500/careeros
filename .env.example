# ---------------------------------------------------------------------------
# CareerOS — environment template
# Copy to apps/web/.env.local (Next.js reads env files from the app directory)
# and fill with values from `supabase status`.
# NEVER commit .env.local or real credentials.
# ---------------------------------------------------------------------------

# Public Supabase endpoint (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key. Public by design: Row Level Security is the
# access control, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Canonical app URL used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Phase 1 does not use the service-role key in the web app at all; it is listed
# for the future worker processes, which will read it from their own env.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ---------------------------------------------------------------------------
# AI providers (Phase 3+). Provider-independent; the base URL is configuration
# so no deployment is tied to a single vendor or aggregator.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_MAP=

# ---------------------------------------------------------------------------
# Direct database URL — used only by integration tests, never by the app.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
