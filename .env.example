# ---------------------------------------------------------------------------
# CareerOS — environment template
#
# Two files, two purposes, both git-ignored:
#
#   .env                 local infrastructure: docker compose + migration scripts
#   apps/web/.env.local  Next.js app runtime
#
# Never commit either file. Never put real credentials in this template.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Local PostgreSQL (docker compose + migration tooling) — root `.env`
#
# `pnpm pg:up` creates `.env` and generates strong random values for the three
# passwords if they are missing. The placeholders below are only for reference.
#
#   POSTGRES_ADMIN_PASSWORD   container superuser; bootstrap only, never used
#                             by the application
#   CAREEROS_OWNER_PASSWORD   migrations and schema ownership (DDL); must stay
#                             separate from runtime credentials
#   CAREEROS_APP_PASSWORD     the only runtime login; no DDL, no ownership,
#                             cannot bypass RLS
#
# CAREEROS_PG_PORT is chosen by the preflight script (5432, else 55432).
# ---------------------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=replace-me
CAREEROS_OWNER_PASSWORD=replace-me
CAREEROS_APP_PASSWORD=replace-me
CAREEROS_PG_PORT=5432

# ---------------------------------------------------------------------------
# Current Phase 1 Supabase runtime — goes in apps/web/.env.local.
# Removed from the runtime in Stage 7 of the migration.
# ---------------------------------------------------------------------------

# Public Supabase endpoint (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/publishable key. Public by design: Row Level Security is the
# access control, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Canonical app URL used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ---------------------------------------------------------------------------
# AI providers (Phase 3+). Provider-independent; the base URL is configuration
# so no deployment is tied to a single vendor or aggregator.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_MAP=

# ---------------------------------------------------------------------------
# Direct database URL — used only by integration tests, never by the app.
# Phase 1 points at Supabase's database; the migration re-points it at the
# local careeros_owner credentials.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
